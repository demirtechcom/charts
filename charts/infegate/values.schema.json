{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Infegate 1.0.6 values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publicUrl",
    "api",
    "ui",
    "ingress",
    "gateway"
  ],
  "properties": {
    "publicUrl": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "annotations",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoscaling",
        "podDisruptionBudget",
        "strategy",
        "terminationGracePeriodSeconds",
        "startupProbe",
        "readinessProbe",
        "livenessProbe",
        "metrics",
        "image",
        "database",
        "management",
        "oidc",
        "runtime",
        "audit",
        "mcp",
        "subscriptionPassthrough",
        "resources",
        "podSecurityContext",
        "containerSecurityContext",
        "nodeSelector",
        "tolerations",
        "affinity",
        "topologySpreadConstraints",
        "defaultTopologySpread",
        "connectionDrain"
      ],
      "properties": {
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "podDisruptionBudget": {
          "$ref": "#/definitions/podDisruptionBudget"
        },
        "strategy": {
          "$ref": "#/definitions/deploymentStrategy"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "connectionDrain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minSeconds",
            "maxSeconds"
          ],
          "properties": {
            "minSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "maxSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "startupProbe": {
          "$ref": "#/definitions/probe"
        },
        "readinessProbe": {
          "$ref": "#/definitions/probe"
        },
        "livenessProbe": {
          "$ref": "#/definitions/probe"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "port"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret",
            "key",
            "maxConnections"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "maxConnections": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "management": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authenticationMode",
            "externalJwt"
          ],
          "properties": {
            "authenticationMode": {
              "type": "string",
              "enum": [
                "oidc",
                "externalJwt"
              ]
            },
            "externalJwt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "issuer",
                "audiences",
                "jwksUrl",
                "headerName",
                "authorizationRule"
              ],
              "properties": {
                "issuer": {
                  "type": "string"
                },
                "audiences": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "jwksUrl": {
                  "type": "string"
                },
                "headerName": {
                  "type": "string",
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                },
                "authorizationRule": {
                  "type": "string"
                }
              }
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "clientId",
            "scopes",
            "existingSecret",
            "clientSecretKey",
            "cookieSecretKey",
            "authorizationRule"
          ],
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "existingSecret": {
              "type": "string"
            },
            "clientSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "cookieSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "authorizationRule": {
              "type": "string"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capturePayloads",
            "captureMcpPayloads",
            "session",
            "costDetail",
            "sensitiveHeaders",
            "retention"
          ],
          "properties": {
            "capturePayloads": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "captureMcpPayloads": {
              "type": "boolean"
            },
            "session": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "header"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "header": {
                  "type": "string",
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                }
              }
            },
            "costDetail": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "sensitiveHeaders": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
              }
            },
            "retention": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "schedule",
                "payloadDays",
                "metadataDays",
                "podSecurityContext",
                "containerSecurityContext",
                "image",
                "resources"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 1
                },
                "payloadDays": {
                  "type": "integer",
                  "minimum": 1
                },
                "metadataDays": {
                  "type": "integer",
                  "minimum": 2
                },
                "podSecurityContext": {
                  "type": "object"
                },
                "containerSecurityContext": {
                  "type": "object"
                },
                "image": {
                  "$ref": "#/definitions/image"
                },
                "resources": {
                  "type": "object"
                }
              }
            }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "authenticationMode",
            "issuer",
            "headerName",
            "jwksUrl",
            "audiences",
            "authorizationRule"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "authenticationMode": {
              "type": "string",
              "enum": [
                "nativeOAuth",
                "externalJwt"
              ]
            },
            "issuer": {
              "type": "string"
            },
            "headerName": {
              "type": "string",
              "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
            },
            "jwksUrl": {
              "type": "string"
            },
            "audiences": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "authorizationRule": {
              "type": "string"
            }
          }
        },
        "subscriptionPassthrough": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "providers"
          ],
          "properties": {
            "providers": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claude"
              ],
              "properties": {
                "claude": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled",
                    "accessKeys",
                    "maxRequestBytes",
                    "rateLimit"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "accessKeys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "keyHashEnvVar"
                        ],
                        "properties": {
                          "keyHashEnvVar": {
                            "type": "string",
                            "pattern": "^[A-Z_][A-Z0-9_]*$"
                          },
                          "metadata": {
                            "type": "object",
                            "additionalProperties": {
                              "type": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            }
                          }
                        }
                      }
                    },
                    "maxRequestBytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 33554432
                    },
                    "rateLimit": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "enabled",
                        "requestsPerInterval",
                        "interval"
                      ],
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "requestsPerInterval": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "interval": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "defaultTopologySpread": {
          "$ref": "#/definitions/defaultTopologySpread"
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoscaling",
        "podDisruptionBudget",
        "strategy",
        "terminationGracePeriodSeconds",
        "startupProbe",
        "readinessProbe",
        "livenessProbe",
        "image",
        "resources",
        "podSecurityContext",
        "containerSecurityContext",
        "nodeSelector",
        "tolerations",
        "affinity",
        "topologySpreadConstraints",
        "defaultTopologySpread"
      ],
      "properties": {
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "podDisruptionBudget": {
          "$ref": "#/definitions/podDisruptionBudget"
        },
        "strategy": {
          "$ref": "#/definitions/deploymentStrategy"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "startupProbe": {
          "$ref": "#/definitions/probe"
        },
        "readinessProbe": {
          "$ref": "#/definitions/probe"
        },
        "livenessProbe": {
          "$ref": "#/definitions/probe"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "defaultTopologySpread": {
          "$ref": "#/definitions/defaultTopologySpread"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "annotations",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "create",
        "gatewayClassName",
        "annotations",
        "tls",
        "parentRef"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "create": {
          "type": "boolean"
        },
        "gatewayClassName": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "parentRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "namespace",
            "sectionName"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "sectionName": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "deploymentStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object"
        }
      }
    },
    "probe": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "httpGet",
            "tcpSocket",
            "exec",
            "grpc"
          ]
        },
        "httpGet": {
          "type": "object"
        },
        "tcpSocket": {
          "type": "object"
        },
        "exec": {
          "type": "object"
        },
        "grpc": {
          "type": "object"
        }
      }
    },
    "defaultTopologySpread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(100|[0-9]{1,2})%$"
            }
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "behavior"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "behavior": {
          "type": "object"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          ]
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    }
  }
}
